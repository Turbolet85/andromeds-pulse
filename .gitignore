# --- Andromeda planning artifacts ---
# Track plans (architecture, 6 specialist plans, route, project.yaml, state.yaml,
# context/ living artifacts) — they are the source of truth for the CLAUDE.md ecosystem.
# Exclude only the audit-trail run directories (ephemeral; large; per-pipeline-invocation).
.andromeda/runs/

# --- Rust ---
# Build output
target/

# rustfmt backups
**/*.rs.bk

# Cargo.lock policy: COMMIT for binary crates (reproducible builds);
# pulse-app is the binary root, so Cargo.lock IS committed.
# (Do NOT add Cargo.lock to .gitignore.)

# --- Tauri ---
# Updater Minisign keys (NEVER commit private keys)
*.key
~/.tauri/*.key
**/.tauri/*.key
src-tauri/target/

# Tauri 2 auto-generated capability schemas (regenerated by tauri-build per build)
pulse-app/gen/

# --- Node / webview frontend ---
node_modules/
dist/
build/
.next/
coverage/
.parcel-cache/
.turbo/
.vite/

# Frontend env files
.env
.env.local
.env.*.local
.env*

# --- IDE ---
*.iml
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.fleet/

# --- macOS ---
.DS_Store

# --- Windows ---
Thumbs.db
Desktop.ini

# --- Code-signing certificates ---
*.p12
*.pem
*.cer
*.pfx

# --- Test artifacts ---
proptest-regressions/*.txt.bk
.test-logs/
# cargo-llvm-cov output (workspace-root lcov.info from `cargo xtask test:coverage`)
lcov.info
# A11y / Playwright / Lighthouse / pa11y output directories
pulse-app/ui/playwright-report/
pulse-app/ui/test-results/
pulse-app/ui/.lighthouseci/
pulse-app/ui/pa11y-results/
# Screen-reader manual-pass JSONL output (chunk #14 scaffold; redundant
# under pulse-app/ui/test-results/ above but listed explicitly for
# discoverability of the dedicated SR sub-dir)
pulse-app/ui/test-results/a11y-sr/

# --- Andromeda-pulse runtime data (when accidentally created in repo) ---
~/.andromeda-pulse/
.andromeda-pulse/

# --- Claude Code local settings ---
.claude/settings.local.json
.claude/backup/
# Runtime PID lock file (scheduled tasks; ephemeral; per-session)
.claude/scheduled_tasks.lock

# --- Research spikes (throwaway / never commits to main) ---
# Chunk #69 Phase A Drain spike validation (per .andromeda/decisions/pre-d2-drain-spike.md).
# Spike code never commits to main; the findings doc is the only artifact that does.
crates/triage-experimental/
