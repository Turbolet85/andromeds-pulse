{
  "defaults": {
    "runner": ["axe"],
    "standard": "WCAG2AA",
    "viewport": { "width": 1280, "height": 720 },
    "timeout": 30000,
    "reporter": "json",
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-gpu", "--headless=new"]
    }
  },
  "urls": [
    "http://localhost:4173/",
    "http://localhost:4173/#/traces",
    "http://localhost:4173/#/metrics",
    "http://localhost:4173/#/logs",
    "http://localhost:4173/#/snapshots",
    "http://localhost:4173/#/settings"
  ]
}
