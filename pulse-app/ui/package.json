    "typecheck": "tsc --noEmit",
    "verify:contrast": "node scripts/verify-contrast.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "colorjs.io": "^0.6.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
