{
  "name": "andromeda-pulse-ui",
  "version": "0.1.0",
  "private": true,
  "description": "andromeda-pulse webview tokens + assets (Tailwind v4 @theme NASA palette + bundled WOFF2 fonts) + React 19 icon registry + Vite build pipeline",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:css": "tailwindcss -i src/styles/tokens.css -o dist/tokens.css --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "lint": "eslint .",
    "lint:a11y": "eslint .",
    "test:a11y": "npm run verify:contrast && playwright test --config=playwright-a11y.config.ts && node tests-a11y/lighthouse/lighthouse-runner.mjs && node tests-a11y/pa11y/run-pa11y.mjs && node tests-a11y/aggregator.mjs && node tests-a11y/regression-detector.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@crabnebula/tauri-driver": "^2.0.9",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.70",
    "axe-core": "^4.11.0",
    "colorjs.io": "^0.6.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.4.1",
    "pa11y": "^10.0.0",
    "pa11y-ci": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "taurpc": "^1.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.2"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "focus-trap-react": "^12.0.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.0",
    "tabbable": "^6.4.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  }
}
