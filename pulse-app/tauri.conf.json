{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "andromeda-pulse",
  "version": "0.1.0",
  "identifier": "com.andromeda.pulse",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "cd ui && npm install && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "compact-widget",
        "title": "andromeda-pulse",
        "width": 480,
        "height": 270,
        "minWidth": 400,
        "minHeight": 225,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "main",
        "title": "andromeda-pulse",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/turbolet85/andromeda-pulse/releases/latest/download/latest.json"
      ],
      "pubkey": "RWRHXC7qARDfsxhPPJdfh3RMb2f/0THc+5Hrd9n9b/njUTM2I2yTSSpi",
      "dialog": false
    }
  }
}
